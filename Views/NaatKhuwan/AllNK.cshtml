@model List<NaatsWebApp.Models.NaatKhuwaan>

@{
    ViewData["Title"] = "All Naat Reciters";
    var cities = ViewBag.Cities as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">🎤 All Naat Reciters</h2>
        @Html.ActionLink("+ Create New", "SignUp", null,
            new { @class = "btn btn-success px-4 shadow-sm" })
    </div>

    <!-- Search by City -->
    <div class="card shadow mb-4 p-3">
        @using (Html.BeginForm())
        {
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filter by City</label>
                    @Html.DropDownList("city", cities, "-- All Cities --",
                        new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    <input type="submit" value="Search" class="btn btn-primary w-100 mt-2" />
                </div>
                <div class="col-md-2">
                    <a asp-action="AllNK" class="btn btn-outline-secondary w-100 mt-2">Reset</a>
                </div>
            </div>
        }
    </div>

    <!-- Table -->
    <div class="card list-card">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered text-center align-middle table-green mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>City</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                No records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var nk in Model)
                        {
                            <tr>
                                <td>@nk.nkid</td>
                                <td class="fw-semibold">@nk.name</td>
                                <td>@nk.city</td>
                                <td class="action-btns">
                                    @Html.ActionLink("Detail", "Detail",
                                        new { nkid = nk.nkid },
                                        new { @class = "btn btn-primary btn-sm" })
                                    @Html.ActionLink("Edit", "Edit",
                                        new { nkid = nk.nkid },
                                        new { @class = "btn btn-secondary btn-sm" })
                                    @Html.ActionLink("Delete", "Delete",
                                        new { nkid = nk.nkid },
                                        new { @class = "btn btn-danger btn-sm",
                                              onclick = "return confirm('Are you sure you want to delete this record?')" })
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
