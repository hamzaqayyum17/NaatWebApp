<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NaatKhuwaanWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        html, body { height: 100%; }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7f6;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* NAVBAR */
        .navbar { background: linear-gradient(90deg, #0d3b2e, #145c43); }
        .navbar-brand { font-weight: 700; font-size: 22px; color: white !important; }
        .nav-link { color: rgba(255,255,255,0.9) !important; margin-left: 10px; font-weight: 500; transition: color 0.3s; }
        .nav-link:hover { color: #ffd700 !important; }

        /* MAIN CONTENT */
        .main-content { flex: 1; padding-top: 80px; padding-bottom: 40px; }

        /* FOOTER */
        .footer { background: #0d3b2e; color: white; }
        .footer a { color: #ffd700; text-decoration: none; }

        /* BUTTONS */
        .btn-gold {
            background-color: #c8a951; color: white; border: none;
            padding: 10px 28px; border-radius: 10px; font-weight: 600;
            transition: background 0.3s, transform 0.2s;
        }
        .btn-gold:hover { background-color: #a8893e; color: white; transform: scale(1.03); }

        .btn-primary {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
            border: none; border-radius: 10px; padding: 10px 20px;
            font-weight: 600; transition: background 0.3s, transform 0.2s;
        }
        .btn-primary:hover { background: linear-gradient(90deg, #145c43, #0d3b2e); transform: scale(1.02); }
        .btn-secondary { border-radius: 10px; font-weight: 600; }
        .btn-success { border-radius: 10px; font-weight: 600; }

        /* CARDS */
        .card {
            border: none; border-radius: 15px; background: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.07);
            transition: transform 0.3s ease-in-out;
        }
        .card:hover { transform: translateY(-4px); }

        /* FORMS */
        .form-label { font-weight: 600; color: #145c43; }
        .form-control, .form-select {
            border-radius: 10px; padding: 10px 12px;
            border: 1px solid #dcdcdc; transition: border-color 0.3s, box-shadow 0.3s;
        }
        .form-control:focus, .form-select:focus {
            border-color: #145c43; box-shadow: 0 0 0 0.15rem rgba(20,92,67,0.25);
        }
        .input-group-text {
            background: #145c43; color: white; border: none;
            border-radius: 10px 0 0 10px;
        }
        .input-group .form-control { border-radius: 0 10px 10px 0 !important; }
        input[type="radio"], input[type="checkbox"] { accent-color: #145c43; }

        /* SIGNIN PAGE */
        .login-title { font-weight: 700; color: #0d3b2e; }
        .login-card { border: none; border-radius: 18px; box-shadow: 0 15px 40px rgba(0,0,0,0.08); border-top: 6px solid #145c43; }
        .register-link { font-size: 14px; color: #555; }
        .register-link a { text-decoration: none; color: #145c43; font-weight: 600; }
        .register-link a:hover { color: #0d3b2e; text-decoration: underline; }

        /* DETAIL PAGE */
        .detail-card { border: none; border-radius: 18px; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.08); }
        .detail-header { background: linear-gradient(90deg, #0d3b2e, #145c43); color: white; padding: 20px 24px; }
        .detail-header h3 { font-weight: 700; color: white; margin: 0; }
        .detail-label { font-weight: 600; color: #145c43; }
        .detail-value { color: #333; font-size: 15px; }

        /* ALL NK PAGE */
        .page-title { font-weight: 700; color: #0d3b2e; }
        .list-card { border: none; border-radius: 18px; box-shadow: 0 15px 35px rgba(0,0,0,0.08); overflow: hidden; }
        .table-green thead { background: linear-gradient(90deg, #0d3b2e, #145c43); color: white; }
        .table-green tbody tr:hover { background-color: #f1f9f6; }
        .action-btns .btn { margin: 2px; }

        /* VIEW NAATS PAGE */
        .naat-table-wrapper { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.07); overflow: hidden; }
        .naat-info-card { background: #e9f7f3; border-left: 5px solid #145c43; padding: 14px 18px; border-radius: 10px; margin-bottom: 20px; }
        audio { width: 100%; border-radius: 8px; }

        /* RESPONSIVE */
        @@media (max-width: 768px) {
            .main-content { padding-top: 70px; }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🎤 NaatKhuwaan
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navContent"
                    aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="NaatKhuwan" asp-action="AllNK">
                            <i class="bi bi-people-fill me-1"></i>All Reciters
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="NaatKhuwan" asp-action="SignUp">
                            <i class="bi bi-person-plus-fill me-1"></i>Register
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="NaatKhuwan" asp-action="SignIn">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN BODY -->
    <div class="main-content container">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer text-center py-4">
        <div class="container">
            <h5 class="fw-bold">🎤 NaatKhuwaanWebApp</h5>
            <p class="mb-1">Promoting the Art of Naat Recitation</p>
            <small>© @DateTime.Now.Year All Rights Reserved</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
