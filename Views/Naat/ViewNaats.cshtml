@model List<NaatsWebApp.Models.Naat>

@{
    ViewData["Title"] = "View Naats";
    var sessionid   = Context.Session.GetString("nkid");
    var sessionname = Context.Session.GetString("name");
    var ano         = Context.Request.Query["ano"];
    var title       = Context.Request.Query["title"];
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color:#0d3b2e;">Naats</h2>
            <p class="text-muted mb-0">
                Album: <strong>@title</strong> &nbsp;|&nbsp; No: <strong>@ano</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            @Html.ActionLink("Add Naat", "AddNaat", "Naat",
                new { ano = ano, title = title },
                new { @class = "btn btn-success btn-sm" })
            <a asp-controller="Album" asp-action="ViewAlbums"
               class="btn btn-secondary btn-sm">Back to Albums</a>
        </div>
    </div>

    <div class="naat-info-card mb-4">
        <i class="bi bi-person-fill me-2"></i>
        <strong>@sessionname</strong>
        <span class="text-muted ms-3">ID: @sessionid</span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-music-note-beamed" style="font-size:3rem; color:#ccc;"></i>
                <h5 class="mt-3 text-muted">No naats found in this album</h5>
                @Html.ActionLink("Upload First Naat", "AddNaat", "Naat",
                    new { ano = ano, title = title },
                    new { @class = "btn btn-primary mt-2" })
            </div>
        </div>
    }
    else
    {
        <div class="naat-table-wrapper">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-green">
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Naat Title</th>
                        <th>Play</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var naat in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@naat.nno</td>
                            <td class="fw-semibold">@naat.naattitle</td>
                            <td style="min-width:280px;">
                                <audio controls>
                                    <source src="@naat.naatpath" type="audio/mpeg" />
                                    <source src="@naat.naatpath" type="video/mp4" />
                                    Your browser does not support audio playback.
                                </audio>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted mt-3 text-end" style="font-size:13px;">
            Total: <strong>@Model.Count</strong> naat(s)
        </p>
    }

</div>
