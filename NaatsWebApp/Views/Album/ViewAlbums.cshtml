@model List<NaatsWebApp.Models.Album>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

@{
    var sessionid = Context.Session.GetString("nkid");
    var sesionname = Context.Session.GetString("name");
}

<div class="container mt-5">

    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">📀 My Albums</h2>
        <p class="text-muted">Manage and explore your albums</p>
    </div>

    <!-- User Info Card -->
    <div class="card shadow mb-4">
        <div class="card-body text-center">
            <h5 class="mb-1">👤 @sesionname</h5>
            <p class="text-muted mb-0">User ID: <b>@sessionid</b></p>
        </div>
    </div>

    <!-- Albums Grid -->
    <div class="row g-4">
        @foreach (var album in Model)
        {
            <div class="col-md-4">
                <div class="card shadow h-100 border-0">

                    <!-- Image -->
                    <div style="height: 220px; background:#f8f9fa; display:flex; align-items:center; justify-content:center;">
                        <img src="@album.imgpath"
                             class="img-fluid"
                             style="max-height: 100%; object-fit: contain;" />
                    </div>

                    <!-- Body -->
                    <div class="card-body text-center d-flex flex-column">
                        <h5 class="fw-semibold mb-2">Album # @album.ano</h5>
                        <p class="text-muted mb-3">@album.title</p>

                        @Html.ActionLink("🎵 Add Naat", "AddNaat", "Naat",
                            new { ano = album.ano, title = album.title },
                            new { @class = "btn btn-primary mt-auto w-100 shadow-sm" })
                    </div>

                </div>
            </div>
        }
    </div>

</div>