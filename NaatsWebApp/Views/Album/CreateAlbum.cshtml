@model NaatsWebApp.Models.Album

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">📀 Create Album</h2>
            <p class="text-muted mb-0">Add a new album to your collection</p>
        </div>

        <!-- Back Button Top -->
        <a href="/Album/ViewAlbums" class="btn btn-secondary shadow-sm">
            ⬅ Back
        </a>
    </div>

    <!-- User Info -->
    <div class="card shadow mb-4">
        <div class="card-body text-center">
            <h5 class="mb-1">👤 @Context.Session.GetString("name")</h5>
            <p class="text-muted mb-0">
                User ID: <b>@Context.Session.GetString("nkid")</b>
            </p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card shadow">
        <div class="card-body p-4">

            @using (Html.BeginForm("CreateAlbum", "Album", FormMethod.Post,
                                        new { enctype = "multipart/form-data" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">Album No</label>
                    @Html.EditorFor(model => model.ano,
                        new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Title</label>
                    @Html.EditorFor(model => model.title,
                        new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Year</label>
                    @Html.EditorFor(model => model.year,
                        new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Choose Image</label>
                    @Html.TextBoxFor(model => model.imgfile,
                        new { type = "file", @class = "form-control" })
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    
                    <!-- Back Button Bottom -->
                    <a href="/Album/ViewAlbums" class="btn btn-outline-secondary">
                        ⬅ Back
                    </a>

                    <input type="submit" value="➕ Submit"
                           class="btn btn-success px-4 shadow-sm" />
                </div>
            }

        </div>
    </div>

</div>