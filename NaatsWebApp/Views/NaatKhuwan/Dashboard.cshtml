@{
    var nkid = Context.Session.GetString("nkid");
    var name = Context.Session.GetString("name");
}

<div class="container mt-5">

    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">🎤 NaatKhuwaan Dashboard</h2>
        <p class="text-muted">Manage your albums and profile</p>
    </div>

    <!-- User Info Card -->
    <div class="card shadow mb-4">
        <div class="card-body text-center">
            <h4 class="fw-semibold">Welcome, @name 👋</h4>
            <p class="text-muted mb-0">User ID: <b>@nkid</b></p>
        </div>
    </div>

    <!-- Action Cards -->
    <div class="row g-4">

        <!-- Create Album -->
        <div class="col-md-4">
            <div class="card shadow h-100 text-center border-0">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="mb-3">📀 Create Album</h5>
                    <a asp-controller="Album" asp-action="CreateAlbum"
                       class="btn btn-primary w-100">
                        + Create
                    </a>
                </div>
            </div>
        </div>

        <!-- View Albums -->
        <div class="col-md-4">
            <div class="card shadow h-100 text-center border-0">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="mb-3">📂 My Albums</h5>
                    <a asp-controller="Album" asp-action="ViewAlbums"
                       class="btn btn-info w-100 text-white">
                        View Albums
                    </a>
                </div>
            </div>
        </div>

        <!-- All NaatKhuwaan -->
        <div class="col-md-4">
            <div class="card shadow h-100 text-center border-0">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="mb-3">🎤 All NaatKhuwaan</h5>
                    <a asp-controller="NaatKhuwan" asp-action="AllNK"
                       class="btn btn-secondary w-100">
                        View All
                    </a>
                </div>
            </div>
        </div>

    </div>

</div></div>