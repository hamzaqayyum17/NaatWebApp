<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NaatKhuwaanWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7f6;
            display: flex;
            flex-direction: column;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 22px;
        }

        .nav-link {
            color: white !important;
            margin-left: 15px;
            position: relative;
            transition: 0.3s;
        }

            .nav-link:hover {
                color: #ffd700 !important;
            }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            flex: 1;
            padding-top: 100px; /* Space for fixed navbar */
        }

        /* ===== FOOTER ===== */
        .footer {
            background: #0d3b2e;
            color: white;
        }

            .footer a {
                color: #ffd700;
                text-decoration: none;
            }

        /* ===== CARD DESIGN ===== */
        .card {
            border: none;
            border-radius: 15px;
            background: white;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease-in-out;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        /* ===== FORM LABELS ===== */
        .form-label {
            font-weight: 600;
            color: #145c43;
        }

        /* ===== INPUT FIELDS ===== */
        .form-control, .form-select {
            border-radius: 10px;
            padding: 10px 12px;
            border: 1px solid #dcdcdc;
            transition: 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #145c43;
                box-shadow: 0 0 0 0.15rem rgba(20, 92, 67, 0.25);
            }

        /* ===== RADIO BUTTONS ===== */
        input[type="radio"] {
            accent-color: #145c43;
        }

        /* ===== CHECKBOX ===== */
        input[type="checkbox"] {
            accent-color: #145c43;
        }

        /* ===== BUTTON DESIGN ===== */
        .btn-primary {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
            border: none;
            border-radius: 10px;
            padding: 10px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-primary:hover {
                background: linear-gradient(90deg, #145c43, #0d3b2e);
                transform: scale(1.02);
            }

        /* ===== PAGE HEADING ===== */
        h2 {
            font-weight: 700;
            color: #0d3b2e;
        }

        /* ===== SUCCESS INFO BOX AFTER POST ===== */
        .post-info {
            background-color: #e9f7f3;
            border-left: 5px solid #145c43;
            padding: 15px;
            margin-top: 20px;
            border-radius: 8px;
        }

        /* ===== LOGIN PAGE SPECIFIC ===== */
        .login-card {
            border-radius: 18px;
            border: none;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease-in-out;
        }

            .login-card:hover {
                transform: translateY(-6px);
            }

        /* Input icons wrapper */
        .input-group-text {
            background: #145c43;
            color: white;
            border: none;
            border-radius: 10px 0 0 10px;
        }

        .input-group .form-control {
            border-radius: 0 10px 10px 0 !important;
        }

        /* Login heading style */
        .login-title {
            font-weight: 700;
            color: #0d3b2e;
        }

        /* Register link */
        .register-link a {
            text-decoration: none;
            color: #145c43;
            font-weight: 600;
        }

            .register-link a:hover {
                color: #0d3b2e;
                text-decoration: underline;
            }

        /* Message box */
        .message-box {
            background: #e9f7f3;
            border-left: 5px solid #145c43;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        /* ===== UPDATE PAGE DESIGN ===== */

        .update-card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.07);
            border-top: 6px solid #145c43;
            transition: 0.3s ease-in-out;
        }

            .update-card:hover {
                transform: translateY(-4px);
            }

        /* Section Title */
        .update-title {
            font-weight: 700;
            color: #0d3b2e;
        }

        /* Gender radio styling */
        .gender-group input[type="radio"] {
            margin-right: 5px;
            accent-color: #145c43;
        }

        .gender-group label {
            margin-right: 20px;
            font-weight: 500;
        }

        /* Checkbox alignment */
        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .checkbox-wrapper input[type="checkbox"] {
                transform: scale(1.2);
                accent-color: #145c43;
            }

        /* Back button */
        .btn-secondary {
            border-radius: 10px;
            font-weight: 600;
        }

        /* Save button already styled from previous CSS */
        /* ===== DETAIL PAGE DESIGN ===== */

        .detail-card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease-in-out;
        }

            .detail-card:hover {
                transform: translateY(-5px);
            }

        /* Header */
        .detail-header {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
            color: white;
            padding: 20px;
        }

            .detail-header h3 {
                font-weight: 700;
            }

        /* Label Column */
        .detail-label {
            font-weight: 600;
            color: #145c43;
        }

        /* Value Column */
        .detail-value {
            color: #333;
        }

        /* Footer */
        .detail-footer {
            background-color: #f8f9fa;
        }

        /* Styled badge */
        .badge-status {
            font-size: 14px;
            padding: 6px 12px;
            border-radius: 20px;
        }
        /* ===== DASHBOARD DESIGN ===== */

        .dashboard-card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease-in-out;
        }

            .dashboard-card:hover {
                transform: translateY(-5px);
            }

        .dashboard-header {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
            color: white;
            padding: 20px;
            border-radius: 18px 18px 0 0;
        }

            .dashboard-header h2 {
                font-weight: 700;
                margin: 0;
                color: white;
            }

        .dashboard-label {
            font-weight: 600;
            color: #145c43;
        }

        .dashboard-value {
            font-size: 16px;
            color: #333;
        }

        .welcome-text {
            font-size: 18px;
            font-weight: 600;
            color: #145c43;
        }
        /* ===== ALL NAATKHUWAAN PAGE ===== */

        .list-card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease-in-out;
        }

            .list-card:hover {
                transform: translateY(-4px);
            }

        /* Green table header */
        .table-green thead {
            background: linear-gradient(90deg, #0d3b2e, #145c43);
            color: white;
        }

        /* Table row hover */
        .table-green tbody tr:hover {
            background-color: #f1f9f6;
            transition: 0.2s;
        }

        /* Search Card */
        .search-card {
            border-radius: 15px;
            border: none;
        }

        /* Action button spacing */
        .action-btns .btn {
            margin: 2px;
        }

        /* Page Title */
        .page-title {
            font-weight: 700;
            color: #0d3b2e;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand text-white" href="/">NaatKhuwaan</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/NaatKhuwan/AllNk">NaatKhuwans</a></li>
                    <li class="nav-item"><a class="nav-link" href="/NaatKhuwan/SignUp">Register</a></li>
                    <li class="nav-item"><a class="nav-link" href="/NaatKhuwan/SignIn">Login</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== MAIN BODY ===== -->
    <div class="main-content container">
        @RenderBody()
    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="footer text-center py-4">
        <div class="container">
            <h5 class="fw-bold">NaatKhuwaanWebApp</h5>
            <p class="mb-1">Promoting the Art of Naat Recitation</p>
            <small>© @DateTime.Now.Year All Rights Reserved</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>